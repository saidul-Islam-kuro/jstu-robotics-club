# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API
# Both are safe to expose in the browser (the anon key is public by design;
# your database is protected by Row Level Security policies, not by hiding this key).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
